# Copy to `.env` and adjust. Every variable is optional and shown with its default.

# DEBUG, INFO, WARNING, ERROR or CRITICAL
FINDERY_LOG_LEVEL=INFO

# Directory for the SQLite database and other runtime files
FINDERY_DATA_DIR=data

# User-Agent header sent to the platforms; defaults to findery/<version>
# FINDERY_USER_AGENT=findery/0.1.0

# Telegram bot: token from @BotFather and your numeric ID from @userinfobot.
# Without the token the app only polls and stores listings.
FINDERY_TELEGRAM_BOT_TOKEN=
FINDERY_TELEGRAM_USER_ID=

# File with search profiles, see profiles.example.toml
# FINDERY_PROFILES_FILE=profiles.toml

# Seconds between scheduler checks, and paging limits of one poll
# FINDERY_TICK_SECONDS=60
# FINDERY_POLL_MAX_PAGES=3
# FINDERY_INITIAL_MAX_PAGES=20
# FINDERY_PAGE_DELAY=1.0
# FINDERY_ALERTS_PER_TICK=20
# FINDERY_ALERT_DELAY=1.0
